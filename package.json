    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "clsx": "2.1.1",
    "jose": "6.1.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "emoji-regex": "10.6.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
